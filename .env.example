# Slack (user token xoxp-..., needs channels:history, groups:history, channels:read,
# users:read, search:read scopes)
SLACK_USER_TOKEN=xoxp-...

# GitHub (personal access token with repo scope)
GITHUB_TOKEN=ghp_...

# Notion (internal integration token, share pages/databases with the integration)
NOTION_TOKEN=secret_...

# Postgres (read-only tools only run SELECT/WITH/EXPLAIN)
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Google (Gmail/Calendar/Drive) - OAuth installed-app flow for a personal account.
# 1. In Google Cloud Console, create an OAuth Client ID of type "Desktop app".
# 2. Download it and save as credentials/client_secret.json
# 3. First tool call opens a browser to authorize; token is cached at credentials/token.json
GOOGLE_CREDENTIALS_DIR=credentials

# Groq (for agent.py, the LangChain/LangGraph MCP agent) - free API key from
# https://console.groq.com/keys
GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile
# MCP_SERVER_URL=http://127.0.0.1:8000/mcp
